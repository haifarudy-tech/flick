# ------------------------------------------------------------------
# Flick server — environment variables
# Copy this file to `.env` and fill in the values. Never commit .env.
# ------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Postgres (Supabase "Connection string" — URI format)
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Supabase
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=replace-with-64-random-hex
JWT_REFRESH_SECRET=replace-with-another-64-random-hex
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis (Upstash — use the "rediss://" TLS URL)
REDIS_URL=rediss://default:<token>@<host>:<port>

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Delivery platforms — fill in as your partner approvals come through
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
UBER_EATS_WEBHOOK_SECRET=
DELIVEROO_CLIENT_ID=
DELIVEROO_CLIENT_SECRET=
DELIVEROO_WEBHOOK_SECRET=
JUST_EAT_CLIENT_ID=
JUST_EAT_CLIENT_SECRET=
JUST_EAT_WEBHOOK_SECRET=

# Encryption key for at-rest delivery platform tokens (32 bytes base64)
TOKEN_ENCRYPTION_KEY=

# Cookie domain in production (e.g. .flickpos.com)
COOKIE_DOMAIN=

# Logging
LOG_LEVEL=info

# Sentry (optional)
SENTRY_DSN=
