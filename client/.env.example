# ------------------------------------------------------------------
# Flick client — environment variables
# Copy this file to `.env.local` for local dev. Never commit .env.local.
#
# Only variables prefixed with VITE_ are exposed to the browser.
# Never put secrets (server keys, Stripe secret) in here.
# ------------------------------------------------------------------

# Where to send API requests. Use http://localhost:3000 during local dev.
VITE_API_URL=http://localhost:3000

# Supabase (safe — anon key is public by design)
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Stripe — the publishable key is safe to ship to the browser
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Sentry DSN (optional)
VITE_SENTRY_DSN=
